# ==============================================================================
# Configuração NEAT v2 - Otimizada para Evolução Consistente (4GB RAM / Intel Core)
# 70 Entradas (Tabuleiro + Heurísticas) -> 4 Ocultos -> 1 Saída (Qualidade)
# ==============================================================================

[NEAT]
fitness_criterion      = max
fitness_threshold      = 1000000.0
pop_size               = 60
reset_on_extinction    = True
no_fitness_termination = False

[DefaultGenome]
activation_default      = relu
activation_mutate_rate  = 0.15
activation_options      = sigmoid relu tanh

aggregation_default     = sum
aggregation_mutate_rate = 0.0
aggregation_options     = sum

bias_init_mean          = 0.0
bias_init_stdev         = 1.0
bias_max_value          = 30.0
bias_min_value          = -30.0
bias_mutate_power       = 0.5
bias_mutate_rate        = 0.7
bias_replace_rate       = 0.1

compatibility_disjoint_coefficient = 1.0
compatibility_weight_coefficient   = 0.5

# Mutação estrutural agressiva para sair de mínimos locais
conn_add_prob           = 0.40
conn_delete_prob        = 0.10
node_add_prob           = 0.20
node_delete_prob        = 0.05

feed_forward            = True
initial_connection      = full_direct

# 79 Entradas: 64 células + 15 heurísticas estratégicas (inclui Combo Sustentável e Tolerância)
num_inputs              = 79
# 4 neurônios ocultos: leve o bastante para 4GB RAM, forte o bastante para estratégia
num_hidden              = 4
# 1 Saída: Pontuação de utilidade/qualidade da jogada
num_outputs             = 1

weight_init_mean        = 0.0
weight_init_stdev       = 1.0
weight_max_value        = 30.0
weight_min_value        = -30.0
weight_mutate_power     = 0.65
weight_mutate_rate      = 0.8
weight_replace_rate     = 0.1

enabled_default         = True
enabled_mutate_rate     = 0.01

response_init_mean      = 1.0
response_init_stdev     = 0.0
response_max_value      = 30.0
response_min_value      = -30.0
response_mutate_power   = 0.0
response_mutate_rate    = 0.0
response_replace_rate   = 0.0

[DefaultSpeciesSet]
compatibility_threshold = 4.0

[DefaultStagnation]
species_fitness_func = max
max_stagnation       = 25
species_elitism      = 2

[DefaultReproduction]
# Elitismo = 2: Os 2 melhores são preservados intactos
elitism            = 2
survival_threshold = 0.3
min_species_size   = 2
